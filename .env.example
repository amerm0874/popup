SITE_URL=https://popupwash.com
# Enable only after purchasing and connecting the production domain.
INDEXING_ENABLED=false
# Vercel dashboard: Analytics > Enable, then redeploy.
ANALYTICS_ENABLED=true

# Optional owner-verification tokens issued by Google Search Console / Bing.
# Public metadata tokens only; never put account passwords or API keys here.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
